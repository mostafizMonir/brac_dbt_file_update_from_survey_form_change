# Database Configuration
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Git Repository Configuration
# Change this to your repository URL
GIT_REPO_URL=https://bitbucket.org/your_org/your_repo.git
GIT_BRANCH=dev

# Repository Local Path
REPO_PATH=./brac_dbt

# Bitbucket Authentication (Optional)
# Use your Bitbucket username and App Password
# Create App Password at: https://bitbucket.org/account/settings/app-passwords/
# Leave empty if using a public repository
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_API_TOKEN=your_bitbucket_app_password